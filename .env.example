SECRET_KEY=""

# PostgreSQL connection string — leave unset to use local SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Runtime mode
DEBUG=false

# Session cookie and HTTPS behavior
# Local HTTP development: keep both false
# HTTPS deployment: set both true
SESSION_COOKIE_NAME=julies_demiplane_session
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
